# AI 供应商：zhipu（智谱）或 openai。默认示例使用智谱。
AI_PROVIDER=zhipu

# 智谱开放平台配置。不要把真实密钥提交到 Git。
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-4.7-flashx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 智谱联网搜索设置。search_pro 质量较高；如账户仅开通基础搜索，可改为 search_std。
ZHIPU_SEARCH_ENGINE=search_pro
ZHIPU_SEARCH_COUNT=20
ZHIPU_SEARCH_CONTENT_SIZE=high
ZHIPU_THINKING=disabled
ZHIPU_DIRECT_SEARCH_COUNT=50
ZHIPU_INDUSTRY_QUERY_COUNT=8
ZHIPU_DIRECT_INDUSTRY_SEARCH_COUNT=15
INDUSTRY_RSS_ITEMS_PER_FEED=20
INDUSTRY_RSS_TIMEOUT_MS=30000
ZHIPU_DIRECT_PARTNER_SEARCH_COUNT=8
ZHIPU_DIRECT_SEARCH_TIMEOUT_MS=60000
ZHIPU_DIRECT_SEARCH_CONCURRENCY=4
ZHIPU_PARTNER_SEARCH_BATCH_SIZE=3

# 如果改用 OpenAI，请把 AI_PROVIDER 改为 openai，并取消下面三行的注释。
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# 主 API 请求最长等待 5 分钟；报告最大输出 token 数。
AI_REQUEST_TIMEOUT_MS=300000
AI_MAX_OUTPUT_TOKENS=40000

# 主生成或补搜返回非法 JSON、超时或临时服务错误时自动重试。
AI_REQUEST_ATTEMPTS=2
AI_RETRY_DELAY_MS=1500
AI_REPAIR_REQUEST_TIMEOUT_MS=120000
AI_PROGRESS_INTERVAL_MS=30000

# 行业栏目不足最低条数时，自动定向补搜次数。可设置 0-5。
INDUSTRY_REPAIR_ATTEMPTS=2

# Partner 链接过滤后不足最低条数时，自动补搜次数。可设置 0-5。
PARTNER_REPAIR_ATTEMPTS=1

# 真实新闻页面验证：并发数、单页超时、最小正文长度与最大页面体积。
PAGE_FETCH_CONCURRENCY=4
PAGE_FETCH_TIMEOUT_MS=20000
PAGE_MIN_TEXT_CHARS=250
PAGE_MAX_BYTES=5242880

# 日报设置
REPORT_TIMEZONE=Asia/Shanghai
REPORT_RETENTION_DAYS=20

# 可选：回放或补录某天，格式 YYYY-MM-DD。日常运行请留空。
REPORT_DATE=
